# ==============================================================================
# AMBIENTE LOCAL & GOOGLE CLOUD SQL / FIREBASE
# ==============================================================================

# 1. Banco de Dados PostgreSQL da Google (Google Cloud SQL)
# Exemplo Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_escolar?schema=public"

# Exemplo Google Cloud SQL (IP Público com SSL):
# DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@34.xxx.xxx.xxx:5432/gestao_escolar?sslmode=require"

# Exemplo Google Cloud SQL (Unix Domain Socket no Google Cloud Run / App Hosting):
# DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost/gestao_escolar?host=/cloudsql/SEU_PROJECT_ID:southamerica-east1:SUA_INSTANCIA"

# 2. Autenticação (Auth.js / NextAuth v5)
# Gere uma nova chave com: npx auth secret
AUTH_SECRET="f6c8d7e9a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f6a7b8c9d0e1f2"
NEXTAUTH_URL="https://seu-app.web.app"

# 3. Configurações da Aplicação
NEXT_PUBLIC_APP_NAME="Cursinho Pro - Gestão Escolar"
NODE_ENV="production"

# 4. Gateway de Pagamento & Cobrança Bancária Asaas (API v3)
# Documentação: https://docs.asaas.com/
# Obtenha em: Asaas > Menu Usuário > Integrações > Gerar Chave de API
ASAAS_ENVIRONMENT="sandbox" # "sandbox" (testes) ou "production"
ASAAS_API_KEY="$aact_YTU5YTE0M2M6N2Zk..." # Chave de API do Asaas
ASAAS_WEBHOOK_SECRET="seu_token_secreto_de_webhook_asaas"

# 5. Gateway de Pagamento & Maquininha SmartPOS (Mercado Pago / Stone)
# MERCADO_PAGO_ACCESS_TOKEN="APP_USR-xxxx"
# STONE_API_KEY="stone_xxxx"
